# configures NextJS
NEXT_TELEMETRY_DISABLED=1

# configures WebOps
## Enable re-using node_modules from previous runs for faster builds
USE_BUILD_CACHE=true

## Enable Incremental Static Builds (ISB):
## https://www.faststore.dev/releases/2022/05/19/webops
USE_STALE_CACHE=true

## Production site host your users will
## access your website
SITE_HOST=demo.faststore.dev

# configures the runtime Content Security Policy (src/server/csp)
## Origin of the data-plane CSP settings API. Default: https://faststore.vtex.com
## (the same default as WEBOPS_API_URL).
## The store reads GET {DATA_PLANE_API_URL}/api/v1/csp/settings?storeId={account}
# DATA_PLANE_API_URL=https://faststore.vtex.com

## How long CSP settings stay fresh in memory, in milliseconds. Default: 60000
# CSP_SETTINGS_TTL_MS=60000

## How long cached CSP settings are still served after the fresh window when
## data-plane fails, in milliseconds. Default: 600000
# CSP_SETTINGS_STALE_MS=600000

## Timeout for each data-plane settings call, in milliseconds. Default: 500
## After a failed call, the next call for the store starts 60 seconds later.
# CSP_SETTINGS_TIMEOUT_MS=500
