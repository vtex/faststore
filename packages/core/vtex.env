# configures NextJS
NEXT_TELEMETRY_DISABLED=1

# configures WebOps
## Enable re-using node_modules from previous runs for faster builds
USE_BUILD_CACHE=true

## Enable Incremental Static Builds (ISB):
## https://www.faststore.dev/releases/2022/05/19/webops
USE_STALE_CACHE=true

## Production site host your users will
## access your website
SITE_HOST=demo.faststore.dev

# configures the runtime Content Security Policy (src/server/csp)
## Origin of the data-plane API that serves per-account CSP settings.
## Default: https://faststore.vtex.com (the same default as WEBOPS_API_URL).
# DATA_PLANE_API_URL=https://faststore.vtex.com

## How long (ms) a settings record is reused before a new request. Default: 60000
# CSP_SETTINGS_TTL_MS=60000

## How long (ms) a record is served after the TTL while data-plane fails. Default: 600000
# CSP_SETTINGS_STALE_MS=600000

## Timeout (ms) for one data-plane call. Default: 500
## After a failed call, the next call for the store starts 60 seconds later.
# CSP_SETTINGS_TIMEOUT_MS=500
