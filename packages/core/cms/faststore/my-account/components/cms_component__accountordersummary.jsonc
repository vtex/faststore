{
  "$extends": ["#/$defs/base-component"],
  "$componentKey": "AccountOrderSummary",
  "$componentTitle": "Account Order Summary",
  "title": "Account Order Summary",
  "description": "Order summary section for My Account order details",
  "type": "object",
  "properties": {
    "summaryTitle": {
      "type": "string",
      "title": "Summary Title",
      "default": "Summary"
    },
    "totalLabel": {
      "type": "string",
      "title": "Total Label",
      "default": "Total"
    },
    "interestLabel": {
      "type": "string",
      "title": "Interest Label",
      "default": "Interest"
    },
    "itemsTotalLabel": {
      "type": "string",
      "title": "Items Total Label",
      "default": "Items Total"
    },
    "discountsTotalLabel": {
      "type": "string",
      "title": "Discounts Total Label",
      "default": "Discounts Total"
    },
    "shippingTotalLabel": {
      "type": "string",
      "title": "Shipping Total Label",
      "default": "Shipping Total"
    },
    "taxTotalLabel": {
      "type": "string",
      "title": "Tax Total Label",
      "default": "Tax Total"
    },
    "changeTotalLabel": {
      "type": "string",
      "title": "Change Total Label",
      "default": "Change Total"
    }
  },
  "readOnly": false,
  "writeOnly": false,
  "deprecated": false,
  "$abstract": false
}
